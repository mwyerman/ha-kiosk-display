# Runtime only; never use VITE_* for service credentials.
MEALIE_URL=https://mealie.helios.mxwy.org
MEALIE_API_KEY=
# Trusted-LAN deployment; no second browser pairing key.
KIOSK_REQUIRE_PAIRING=false
# Set the exact HTTPS origin here if using TLS termination with COOKIE_SECURE=false.
ALLOWED_ORIGINS=
# true for HTTPS-only production; false for direct LAN HTTP.
COOKIE_SECURE=false
# Local backend defaults (production image sets these explicitly).
HOST=127.0.0.1
PORT=5176
SESSION_DB=./data/kiosk.sqlite
