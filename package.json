{
  "name": "ha-kiosk-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:kiosk": "vite --mode kiosk --host 0.0.0.0 --port 5175 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.js *.json index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
